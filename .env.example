# =============================================================================
# 基于后量子混合密码的端到端加密即时通讯系统 —— 环境配置示例
# 用法:复制本文件为 .env,按需修改。.env 已被 .gitignore 忽略,严禁提交。
#
# 说明:
#  - 本文件中的 host 默认值面向「本地非容器开发」(go run),即 localhost。
#  - 使用 docker-compose 时,server 容器内的 host 会被 compose 覆盖为服务名
#    (postgres / redis / minio),无需在此修改。
# =============================================================================

# ---- 应用 ----
APP_ENV=development          # development / production
APP_NAME=基于后量子混合密码的端到端加密即时通讯系统
LOG_LEVEL=info               # debug / info / warn / error
RUN_MIGRATIONS=true          # 启动时自动执行数据库迁移

# ---- HTTP 服务 ----
HTTP_ADDR=:8080              # 服务监听地址(容器内固定 :8080)
HTTP_PORT=8080              # 宿主机映射端口(docker-compose 使用)
ADMIN_PORT=5174            # 管理后台容器映射端口(docker-compose 使用)

# ---- TLS / 后量子传输层加固 ----
# 启用后后端以 HTTPS(强制 TLS 1.3)提供,并优先协商混合后量子密钥交换
# X25519MLKEM768(X25519 ‖ ML-KEM-768),抗「先存后解(HNDL)」。
# 本地开发先生成自签证书:  cd apps/server && go run ./cmd/gencert
# 生产请换用受信任 CA 证书,并把路径指过去。
TLS_ENABLED=false
TLS_CERT_FILE=certs/dev-cert.pem
TLS_KEY_FILE=certs/dev-key.pem

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pqchat
POSTGRES_PASSWORD=pqchat_dev_password   # 生产务必改为强随机口令
POSTGRES_DB=pqchat
POSTGRES_SSLMODE=disable

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- MinIO(对象存储,存放客户端加密后的媒体密文)----
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=pqchat
MINIO_ROOT_PASSWORD=pqchat_dev_password  # 生产务必改为强随机口令
MINIO_BUCKET=pqchat-media
MINIO_USE_SSL=false
MINIO_API_PORT=9000          # 宿主机映射:MinIO API
MINIO_CONSOLE_PORT=9001      # 宿主机映射:MinIO 控制台

# ---- JWT(账号会话鉴权;与 E2EE 密钥体系完全独立)----
# 生产请用至少 32 字节随机串,例如:openssl rand -base64 48
JWT_SECRET=please_change_me_to_a_long_random_secret_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ---- SMTP(邮箱验证码;以 QQ 邮箱为例)----
# 注意:SMTP_PASSWORD 填「授权码」而非 QQ 登录密码。
# QQ 邮箱开启 SMTP 后会生成授权码:设置 → 账号 → POP3/IMAP/SMTP 服务。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your_account@qq.com
SMTP_PASSWORD=your_qq_authorization_code
SMTP_FROM=your_account@qq.com
SMTP_FROM_NAME=基于后量子混合密码的端到端加密即时通讯系统

# ---- 验证码策略 ----
VERIFICATION_CODE_TTL=10m            # 验证码有效期
VERIFICATION_SEND_INTERVAL=60s       # 同一邮箱两次发送的最小间隔(防刷)
VERIFICATION_MAX_ATTEMPTS=5          # 单个验证码最大校验失败次数(防爆破)

# ---- 管理后台初始账号 ----
# 用户名不存在且配置了密码时,后端启动会自动创建该管理员(角色 superadmin)。
# 生产务必改为强随机密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
